{
  "name": "dsh-xlanv",
  "version": "1.0.0",
  "description": "xlanv.net (X 蓝V互助平台) 官方 DeepSeek Harness (dsh) 24小时拟人化自动化插件",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-browser",
    "xlanv",
    "x-automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wilming/dsh-xlanv.git"
  },
  "author": "914689349@qq.com",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "name": "dsh-xlanv",
      "displayName": "XLANV X蓝V互助助手",
      "type": "browser-automation",
      "requires": [
        "dsh-browser"
      ],
      "permissions": [
        "net",
        "browser",
        "storage",
        "ui"
      ],
      "skills": [
        "./skills/xlanv-human-reply/SKILL.md"
      ]
    }
  }
}
